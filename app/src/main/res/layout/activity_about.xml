<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/black">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="关于"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="32dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_app_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="WearBus"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_version"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="版本: 1.0.0"
        android:textSize="16sp"
        android:textColor="@color/light_gray"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_developer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开发者: Sumeru"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tv_contact"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="联系方式:\n微信: DreamerQ2022\nQQ: 2016319616"
        android:textSize="14sp"
        android:textColor="@color/light_gray"
        android:layout_marginBottom="24dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tv_license"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="开源协议: GNU GPL v3.0\n版权所有 © 2026 Sumeru"
        android:textSize="14sp"
        android:textColor="@color/light_gray"
        android:layout_marginBottom="32dp"
        android:gravity="center" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="MzQ3Mwo="
        android:textSize="10sp"
        android:textColor="#1A1A1A"
        android:layout_marginTop="16dp"
        android:gravity="center" />
</LinearLayout>