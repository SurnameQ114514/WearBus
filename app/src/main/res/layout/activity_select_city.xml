<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="32dp"
    android:background="@color/black">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="请选择所在城市"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <TextView
        android:id="@+id/tv_located_city"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="可以尝试自动定位当前城市，或手动输入城市名称"
        android:textColor="@color/light_gray"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:gravity="center" />

    <!-- 定位进度条：定位中显示，完成/失败后隐藏 -->
    <ProgressBar
        android:id="@+id/progress_locating"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:layout_marginBottom="8dp"
        android:indeterminate="true"
        android:visibility="gone" />

    <!-- 当前定位步骤说明 -->
    <TextView
        android:id="@+id/tv_locate_step"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="准备开始定位..."
        android:textColor="@color/light_gray"
        android:textSize="14sp"
        android:layout_marginBottom="24dp"
        android:gravity="center" />

    <Button
        android:id="@+id/btn_auto_locate"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="自动定位城市"
        android:textSize="18sp"
        android:backgroundTint="#262626"
        android:textColor="@color/white"
        android:layout_marginBottom="32dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="或手动输入城市名称："
        android:textColor="@color/light_gray"
        android:textSize="16sp"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/et_city_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="例如：杭州市"
        android:textSize="16sp"
        android:textColor="@color/white"
        android:textColorHint="@color/light_gray"
        android:background="@drawable/search_box_background"
        android:paddingHorizontal="16dp"
        android:layout_marginBottom="24dp"
        android:maxLines="1" />

    <Button
        android:id="@+id/btn_save_city"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="保存城市"
        android:textSize="18sp"
        android:backgroundTint="#262626"
        android:textColor="@color/white" />

</LinearLayout>

